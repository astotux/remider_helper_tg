# Токен Telegram-бота (получается у @BotFather)
BOT_TOKEN=

# Путь к файлу базы данных SQLite
DATABASE_PATH=./data/bot.sqlite

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info

# Директория для файлов логов и параметры ротации
LOG_DIR=./logs
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5

# Настройки планировщика и очереди отправки
SCHEDULER_POLL_INTERVAL_MS=5000
QUEUE_POLL_INTERVAL_MS=1000
CHAT_MESSAGE_INTERVAL_MS=2000
MAX_MISSED_OCCURRENCES_PER_REMINDER=3
MAX_DELIVERY_ATTEMPTS=5
